# NexTrAI — Urban Traffic Intelligence & Management Platform
# Environment Configuration Template
# Copy this file to .env and configure for your local or production deployment.
# IMPORTANT: DO NOT commit your active .env file to version control.

# --- Application Runtime ---
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database & Storage ---
DATABASE_URL=sqlite+aiosqlite:///data/nextrai.db
SNAPSHOTS_DIR=data/snapshots

# --- Google Gemini AI Intelligence (Official google-genai SDK) ---
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- Traffic Signal Timing Constraints (IRC:67 Compliance) ---
MIN_GREEN_TIME=10
MAX_GREEN_TIME=45
YELLOW_TIME=3
ALL_RED_TIME=2

# --- Network & CORS Security ---
# Comma-separated list of allowed origins, or '*' for local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
